# MARK / Infeedo AI Clone
#
# Copy this file to .env and replace the placeholder values with your local or
# deployment-specific credentials. Keep .env out of git.

# ---------------------------------------------------------------------------
# Core backend environment
# ---------------------------------------------------------------------------
# Database: Postgres is the default deployment target.
# For local-only SQLite testing, you can use sqlite:///./test.db instead.
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres?sslmode=require
# Postgres schema is owned by alembic — run `alembic upgrade head` on deploy.
# Set true to force create_all on Postgres (throwaway environments only).
DB_CREATE_ALL=false

# Shared cache / queue backend
REDIS_URL=redis://localhost:6379/0

# JWT / auth
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOW_HEADER_ROLE_AUTH=false

# Runtime and rollout controls
TESTING=0
ENABLE_RAG=true
ENABLE_PROACTIVE=true
ENABLE_EVENT_BUS=true
ENABLE_ANALYTICS_EVENTS=true
ENABLE_TICKET_BULK_ACTIONS=true
ENABLE_ALERT_BACKGROUND=true
ALERT_SCAN_INTERVAL_SECONDS=86400
# false = full sentiment (lexicon + optional LLM hybrid) and HR pipeline on every user message
FAST_CHAT_MODE=false
# Layer analysis / emotional / proactive specialists on primary orchestrator replies
ENABLE_MULTI_AGENT_ORCHESTRATION=false

# Sentiment dashboards & sustained negative-pattern HR alerts (not single-message spikes)
SENTIMENT_STALE_DAYS=7
SUSTAINED_NEGATIVE_WINDOW_DAYS=7
SUSTAINED_NEGATIVE_MIN_MESSAGES=3
SUSTAINED_RISK_ALERT_COOLDOWN_HOURS=24
SUSTAINED_RISK_ALERTS_ENABLED=true

# Single-turn HR alerting. Scores are 0-100.
# Alert when one message scores at or below SENTIMENT_ALERT_THRESHOLD, or when
# conversation-level risk reaches RISK_ALERT_THRESHOLD.
SENTIMENT_ALERT_THRESHOLD=30
RISK_ALERT_THRESHOLD=70
# Minimum gap between alerts for the same employee, so HR is not spammed.
ALERT_COOLDOWN_MINUTES=30
# Comma-separated emotions that raise an alert on their own.
EMOTION_ALERT_TRIGGERS=burnout,exhaustion,betrayal,injustice,panic
# When true and Azure OpenAI keys are real (not mock), classify sentiment via LLM JSON first; else lexicon.
SENTIMENT_HYBRID_ENABLED=true
SENTIMENT_LLM_MAX_CHARS=2000
SENTIMENT_LLM_TIMEOUT_SECONDS=12
SENTIMENT_BLEND_ON_DISAGREEMENT=true
SENTIMENT_BLEND_SCORE_GAP_THRESHOLD=0.45
SENTIMENT_BLEND_LLM_WEIGHT=0.55
SENTIMENT_ROLLING_TURNS=5
SENTIMENT_ROLLING_BLEND_WEIGHT=0.25
# Context-aware sentiment: sarcasm detection and richer emotion labels.
USE_ENHANCED_SENTIMENT=true

# ---------------------------------------------------------------------------
# Conversation behaviour
# ---------------------------------------------------------------------------
# IANA timezone used to decide "today" and "end of day" for the daily-ritual
# greeting when a user has no timezone of their own. Invalid values fall back
# to UTC, so a typo degrades quietly rather than crashing — check this first if
# greetings arrive at odd hours.
DEFAULT_DISPLAY_TIMEZONE=Asia/Kolkata
# Local hour (0-23) from which the first chat of the day uses the wind-down
# opener instead of the morning check-in.
WIND_DOWN_HOUR=17
# Employee Assistance Program resources shown when the bot detects distress.
# JSON list of {label, url, description}. Empty falls back to a public helpline
# — set this, or the product offers a generic number rather than your provider.
EAP_RESOURCES_JSON=
# Gate each proactive nudge through the model as well as the rules. Off by
# default: rule-only, no per-nudge LLM cost. Fails open (nudge is sent) on any
# model error, so enabling it cannot silence check-ins.
NUDGE_AI_GATING_ENABLED=false

# MARK intelligence — orchestrator LLM snapshot augments chat; sentiment_logs + employee_scores persist every user turn
ENABLE_MARK_INTELLIGENCE_PIPELINE=true
INTELLIGENCE_USE_LLM=true
INTELLIGENCE_ASYNC_QUEUE_ENABLED=false

# Chat latency (defaults favour fast responses; HR pipeline still runs on each user message)
# Lexicon-only tagging on the chat request path (no hybrid LLM wait per turn). Set false to run full hybrid on every message.
CHAT_SYNC_LEXICON_SENTIMENT=true
# Skip extra orchestrator intelligence LLM snapshot (one fewer model call per message when true).
CHAT_SKIP_INTELLIGENCE_SNAPSHOT=true
# Run wellbeing / memory side-effects after the HTTP response (faster JSON on POST /chat/message).
CHAT_DEFER_NONBLOCKING_SIDE_EFFECTS=true

# AI budget and circuit-breaker safety limits
MONTHLY_AI_BUDGET=1000
CIRCUIT_BREAKER_FAILURES=5
CIRCUIT_BREAKER_TIMEOUT=60
CIRCUIT_BREAKER_SUCCESS=2

# ---------------------------------------------------------------------------
# Azure OpenAI
# ---------------------------------------------------------------------------
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4
# Optional faster/cheaper deployment (e.g. gpt-4o-mini) used only for streaming
# general-chat replies to lower time-to-first-token. Leave empty to use
# AZURE_OPENAI_DEPLOYMENT for everything.
AZURE_OPENAI_FAST_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_RETRY_ATTEMPTS=1

# Serve every model call from the deterministic in-process stub instead of
# calling Azure. Intended for browser end-to-end runs, where an unreachable
# endpoint makes each turn pay a full retry timeout. Never enable in a real
# deployment — the assistant would answer with canned text.
AI_USE_MOCK=false

# ---------------------------------------------------------------------------
# Supabase / auth provider settings
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Data retention (see backend/docs/DATA_RETENTION.md)
# ---------------------------------------------------------------------------
# 0 = keep forever, which is the default for every one of these: deleting
# employee records is a legal and business decision, not something to inherit
# from a config file. Nothing runs automatically — scripts/apply_retention.py
# does the work, so deletion is always an explicit action.
#
# The useful shape is to expire the words well before the derived scores: HR
# keeps the trends it acts on, and what an employee actually typed stops
# existing. Suggested starting points are in the doc.
RETENTION_CHAT_MESSAGES_DAYS=0
RETENTION_SENTIMENT_LOGS_DAYS=0
RETENTION_AUDIT_LOGS_DAYS=0
RETENTION_ANONYMOUS_FEEDBACK_DAYS=0

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_KEY=your-supabase-anon-or-service-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Frontend-facing Supabase values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ---------------------------------------------------------------------------
# OAuth providers (calendar integrations)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# HRMS/Payroll live provider connector credentials
WORKDAY_BASE_URL=
WORKDAY_API_TOKEN=
SAP_SUCCESSFACTORS_BASE_URL=
SAP_SUCCESSFACTORS_API_TOKEN=
ADP_BASE_URL=
ADP_API_TOKEN=
RAZORPAY_BASE_URL=
RAZORPAY_API_TOKEN=

# ---------------------------------------------------------------------------
# Frontend / API base URLs
# ---------------------------------------------------------------------------
# Used by frontend client helpers.
BACKEND_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Frontend API base URL (Vite app).
VITE_API_URL=http://localhost:8000
# Public URL of the frontend — used for SSO post-login redirect and invite emails.
FRONTEND_BASE_URL=http://localhost:8080
# Comma-separated allowed CORS origins for the API. Per-customer deployments set
# this to their real frontend origin(s). Empty = local-dev defaults (localhost +
# 127.0.0.1 on :8080/:5173/:3000).
CORS_ALLOW_ORIGINS=
# Stream-only timeout (ms). Conversation start is not aborted by this timer.
VITE_CHAT_STREAM_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# Workplace v2 — WhatsApp (Twilio webhook + optional outbound)
# ---------------------------------------------------------------------------
# Validate X-Twilio-Signature on inbound /whatsapp/webhook requests.
# Only set false for local tunnel testing, where URL rewriting breaks the HMAC.
# Leaving it false in a deployed environment lets anyone post as Twilio.
WHATSAPP_VALIDATE_SIGNATURE=true
ENABLE_WHATSAPP_CHANNEL=false
ENABLE_WHATSAPP_OUTBOUND=false
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DEFAULT_USER_EMAIL=employee@mark.ai
# JSON or CSV: phone=E.164 or whatsapp:+E164 -> user email (lowercase)
WHATSAPP_USER_MAP=
# Twilio WhatsApp sender (e.g. whatsapp:+14155238886) — required if outbound enabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ---------------------------------------------------------------------------
# Weather-based greeting helpers
# ---------------------------------------------------------------------------
WEATHER_LOCATION=
OPENWEATHER_API_KEY=
WEATHER_API_KEY=

# ---------------------------------------------------------------------------
# Leave & billing (stub / demo tuning)
# ---------------------------------------------------------------------------
ANNUAL_LEAVE_DAYS=25
# Config fallback (used when STRIPE_API_KEY is unset or a Stripe call fails).
BILLING_PLAN_NAME=MARK Business
BILLING_PLAN_TIER=business
BILLING_CYCLE=annual
BILLING_SEAT_LIMIT=250
BILLING_RENEWAL_DAYS=30
BILLING_CURRENCY=USD
BILLING_MONTHLY_ESTIMATE=499.0
# Live billing — set STRIPE_API_KEY to pull the real plan/seats/renewal from
# Stripe. Optionally scope to one subscription or customer.
STRIPE_API_KEY=
STRIPE_SUBSCRIPTION_ID=
STRIPE_CUSTOMER_ID=

# ---------------------------------------------------------------------------
# SSO via OpenID Connect (set all three to enable; frontend hides the SSO
# button when unset). Works with Okta, Azure AD, Auth0, Google Workspace, etc.
# ---------------------------------------------------------------------------
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=SSO
OIDC_PROVIDER_KEY=oidc
OIDC_SCOPES=openid email profile
# Optional: override the callback URL registered at the IdP (else derived from
# the request host as {host}/api/v1/sso/{provider}/callback).
OIDC_REDIRECT_URI=
# Auto-create a MARK user on first SSO login (true) or require a pre-existing
# account (false).
OIDC_AUTO_PROVISION=true

# ---------------------------------------------------------------------------
# SMTP (Email Assistant send)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# ---------------------------------------------------------------------------
# Additional backend settings (not all are in Pydantic Settings; see code)
# ---------------------------------------------------------------------------
# Chat API — backend stream timeout (ms). Frontend: set VITE_CHAT_STREAM_TIMEOUT_MS for the Vite client.
CHAT_STREAM_TIMEOUT_MS=12000
# Inbound email → ticket webhook (email.py) — set a strong random secret in production
EMAIL_HOOK_SECRET=
# Life assistant (workplace) — feature gates (backend app.config.Settings)
# ENABLE_LIFE_ASSISTANT defaults to TRUE in code — the agent handles weather /
# restaurant / cafeteria asks and falls back cleanly without provider keys.
# Set to false to disable explicitly.
ENABLE_LIFE_ASSISTANT=true
ENABLE_PRODUCTIVITY_AGENT=false
# Open-Meteo defaults; override if you use a different stack
# Microsoft Teams (Incoming Webhook for HR fan-out — no OAuth needed).
# Create the webhook on a Teams channel ("Connectors" -> "Incoming Webhook"),
# paste the URL here, and flip the flag. Empty = silent no-op.
ENABLE_TEAMS_NOTIFICATIONS=false
TEAMS_WEBHOOK_URL=
TEAMS_DASHBOARD_URL=

LIFE_WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
LIFE_GEOCODE_BASE_URL=https://geocoding-api.open-meteo.com/v1/search
# Optional Google Places–style search for commutes / lunch (empty = disabled)
LIFE_PLACES_API_URL=
LIFE_PLACES_API_KEY=
# JSON string: cafeteria / menu data for on-prem demos (empty = disabled)
LIFE_CAFETERIA_MENU_JSON=
